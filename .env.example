# Find My Child — environment variables
#
# Copy to `.env` for local work (`cp .env.example .env`) and set the same keys in the hosting
# dashboard for production (currently Northflank). `.env` is git-ignored — never commit real
# values.
#
# The server prints a startup audit listing any critical variable that is missing, so a
# misconfigured deploy says so in the logs instead of failing later.

# ── Core ─────────────────────────────────────────────────────────────────────
# Port the HTTP server listens on.
PORT=8080

# MongoDB connection string. Everything shared between instances lives here: application data,
# login sessions (users and admins) and rate-limit counters.
DB_ATLAS=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/fmcDB?retryWrites=true&w=majority

# Signing secret for login tokens. Changing it logs everyone out (users and admins).
# Use a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-long-random-string

# How long a login token stays valid. Defaults to 7 days.
JWT_EXPIRES_IN=7d

# How long a login session may last before it is discarded, in milliseconds.
# Defaults to 30 days.
SESSION_TTL_MS=2592000000

# Optional alias for JWT_SECRET if you prefer to set only one of them.
# SESSION_SECRET=

# ── Admin access ─────────────────────────────────────────────────────────────
# Username/password login for the admin panel. Leave either one empty and this login is
# disabled entirely (the panel then only accepts Google sign-in for whitelisted admins).
ADMIN_USERNAME=
ADMIN_PASS=

# The super admin's email address: always allowed, cannot be demoted or removed.
SUPER_ADMIN_EMAIL=you@example.com

# ── Google sign-in (optional) ────────────────────────────────────────────────
# Leave both empty to disable Google login; username/password and email OTP still work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain.example/api/auth/google/callback

# ── Email (OTP + notifications) ──────────────────────────────────────────────
# Leave RESEND_API_KEY empty to disable email sending; signup OTP then stays unavailable.
RESEND_API_KEY=
EMAIL_FROM="Find My Child <hello@your-domain.example>"

# ── Image storage (Cloudinary) ───────────────────────────────────────────────
# Required for uploading photos. Uploads are validated from their bytes before being stored.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Browser origins ──────────────────────────────────────────────────────────
# Unset means only pages served by this same server may call the API (the default, and all this
# app needs). Add other browser clients as a comma-separated list, or `*` to allow any site.
# ALLOWED_ORIGINS=https://partner.example,https://app.ngo.org

# ── Anonymous realtime search budget ─────────────────────────────────────────
# The home page's live search works without an account, so each socket connection gets a budget.
SOCKET_QUERY_WINDOW_MS=60000
SOCKET_QUERY_LIMIT=60
SOCKET_MAX_IN_FLIGHT=4
# Set to 1 to log socket connections and per-event activity. Off by default: realtime request
# payloads are user data and are never logged.
# DEBUG_SOCKET=1

# ── AI face matching ─────────────────────────────────────────────────────────
# How many face descriptors stay in each server's memory (~512 bytes each). Records beyond the
# pool are read from the database per scan, so a larger pool costs memory, never correctness.
FACEMATCH_MAX_POOL=20000
# How long a server may serve its cached pool without rebuilding, in milliseconds.
FACEMATCH_POOL_TTL_MS=300000
